# --- Secrets: never commit real env files (only *.env.example is tracked) ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx

# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- Frontend ---
node_modules/
dist/
coverage/
*.tsbuildinfo
.eslintcache
*.log

# --- Backend ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Runtime data: user uploads, generated audio, model weights ---
# Speech models and TTS audio default to ~/.cache/hearmate (outside the repo); these
# rules are a safety net in case PIPER_VOICE_DIR / TTS_CACHE_DIR point inside it.
uploads/
backend/media/
backend/cache/
backend/models/
*.wav
*.mp3
*.ogg
*.webm
*.pkl
*.ckpt
*.bin
*.onnx
*.onnx.json
*.safetensors
