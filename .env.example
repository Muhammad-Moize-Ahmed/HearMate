# Root env, read by docker compose AND the backend (backend/.env, if present, overrides it).
# Copy to `.env` (git-ignored) and fill in your own values. Never commit a real .env file.

# --- PostgreSQL (docker compose service "db"; the backend builds its DB URL from these) ---
POSTGRES_DB=hearmate
POSTGRES_USER=hearmate
POSTGRES_PASSWORD=replace-with-a-local-dev-password
# Host port the database is published on (bound to 127.0.0.1 only).
POSTGRES_PORT=5432
# POSTGRES_HOST=localhost

# --- Backend (all optional in development) ---
# development | test | production. Production refuses to start without a strong SECRET_KEY.
# ENVIRONMENT=development
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset in development, a random key is used per process (tokens reset on restart).
# SECRET_KEY=
# Full URL instead of the POSTGRES_* parts, e.g. from a hosting provider.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
# Comma-separated browser origins allowed to call the API (not needed with the Vite dev proxy).
# CORS_ORIGINS=http://localhost:5173
# LOG_LEVEL=INFO
# json | console (default: console in development, json in production)
# LOG_FORMAT=console
