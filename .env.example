# Root env, read by docker compose AND the backend (backend/.env, if present, overrides it).
# Copy to `.env` (git-ignored) and fill in your own values. Never commit a real .env file.

# --- PostgreSQL (docker compose service "db"; the backend builds its DB URL from these) ---
POSTGRES_DB=hearmate
POSTGRES_USER=hearmate
POSTGRES_PASSWORD=replace-with-a-local-dev-password
# Host port the database is published on (bound to 127.0.0.1 only).
POSTGRES_PORT=5432
# POSTGRES_HOST=localhost

# --- Backend (all optional in development) ---
# development | test | production. Production refuses to start without a strong SECRET_KEY.
# ENVIRONMENT=development
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset in development, a random key is used per process (tokens reset on restart).
# SECRET_KEY=
# Full URL instead of the POSTGRES_* parts, e.g. from a hosting provider.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
# Comma-separated browser origins allowed to call the API (not needed with the Vite dev proxy).
# CORS_ORIGINS=http://localhost:5173
# LOG_LEVEL=INFO
# Days and streaks follow each child's time zone; this is used when a child has none set.
# DEFAULT_TIMEZONE=Asia/Karachi
# json | console (default: console in development, json in production)
# LOG_FORMAT=console

# --- Auth (defaults shown) ---
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=14
# OTP_TTL_MINUTES=15
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
# lax | strict | none. Use "none" only if the frontend and API are on different sites.
# REFRESH_COOKIE_SAMESITE=lax
# Defaults to true in production (and whenever SameSite=none).
# REFRESH_COOKIE_SECURE=

# --- Email ---
# "console" prints emails (with codes) to the backend log: development only.
# Production requires "smtp" and SMTP_HOST.
# EMAIL_BACKEND=console
# EMAIL_FROM=HearMate <no-reply@example.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true

# --- Speech (all optional; defaults shown) ---
# Download the models once with: cd backend && uv run python -m app.cli speech-setup
# Models and generated audio are stored OUTSIDE the repo (~/.cache/hearmate, ~/.cache/huggingface).
# whisper | azure | none
# STT_PROVIDER=whisper
# WHISPER_MODEL=base.en
# STT_MAX_CONCURRENCY=2
# piper | azure | none
# TTS_PROVIDER=piper
# PIPER_VOICE=en_US-lessac-medium
# PIPER_VOICE_DIR=~/.cache/hearmate/piper
# TTS_CACHE_DIR=~/.cache/hearmate/tts
# Folder of licensed sound-effect files named <sound_id>.<ext>, e.g. dog.wav or bird.mp3 (needed for Sound Detective).
# SOUNDS_DIR=
# Azure Speech (needed only if a provider above is "azure"):
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# AZURE_TTS_VOICE=en-IN-NeerjaNeural
# AZURE_STT_LANGUAGE=en-IN
# SPEECH_MAX_UPLOAD_BYTES=2000000
# SPEECH_MAX_SECONDS=15
